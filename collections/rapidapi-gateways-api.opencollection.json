    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-RapidAPI-Key",
      "value": "{{X-RapidAPI-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Gateways",
        "type": "folder"
      },
      "items": [
        {
          "info": {

  "info": {
    "_postman_id": "a0ffb3c5-5357-41b6-963e-927e6eead93b",
    "name": "RapidAPI Hub Search API",
    "description": "The RapidAPI Hub API enables developers to discover, search, test, and connect to thousands of APIs through the world's largest API marketplace. Using a single API key, developers can browse APIs across categories such as weather, social media, e-commerce, and finance, test endpoints directly, view auto-generated code snippets in multiple programming languages, and manage subscriptions and usage analytics from a single dashboard.\n\nContact Support:\n Name: RapidAPI Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:52:35.000Z",
    "updatedAt": "2026-10-22T01:52:36.000Z",

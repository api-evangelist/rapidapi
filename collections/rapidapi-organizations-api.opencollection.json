      "type": "apikey",
      "key": "X-RapidAPI-Key",
      "value": "{{X-RapidAPI-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {

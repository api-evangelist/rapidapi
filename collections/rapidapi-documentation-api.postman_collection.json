    "_postman_id": "ee921a97-86cd-405c-8008-9b8e3a4b05c9",
    "name": "RapidAPI Studio Documentation API",
    "description": "RapidAPI Studio is an API design and development environment that enables teams to design, build, and document APIs collaboratively. It supports importing and editing OpenAPI specifications and Postman Collections, providing a visual interface for defining endpoints, parameters, and response schemas. Studio integrates with the broader RapidAPI platform, allowing developers to publish designed APIs directly to the hub and generate documentation automatically from API definitions.\n\nContact Support:\n Name: RapidAPI Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",

{
  "info": {
    "_postman_id": "cecab291-fab4-4e35-9c80-f4fc9d1794c8",
    "name": "RapidAPI REST Platform Applications API",
    "description": "The RapidAPI REST Platform API allows Enterprise Hub administrators to programmatically manage their API hub configurations through RESTful endpoints. It provides CRUD operations for organizations, categories, tags, collections, transactions, subscriptions, users, APIs, and applications. This API enables automation of tasks normally performed through the Enterprise Hub Admin Panel, making it possible to integrate hub management into CI/CD pipelines and custom workflows.\n\nContact Support:\n Name: RapidAPI Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:50:33.000Z",

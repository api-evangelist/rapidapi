{
  "opencollection": "1.0.0",
  "info": {
    "name": "RapidAPI Gateway Alerts Tags API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-RapidAPI-Key",
      "value": "{{X-RapidAPI-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.rapidapi.com/v1/tags"
          },
          "docs": "Retrieves all custom tags configured in the Enterprise Hub. Tags are used to add metadata to APIs for filtering and search."
        },
        {
          "info": {
            "name": "Create a tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.rapidapi.com/v1/tags",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new custom tag in the Enterprise Hub for categorizing APIs."
        },
        {
          "info": {
            "name": "Delete a tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://gateway.rapidapi.com/v1/tags/:tagId",
            "params": [
              {
                "name": "tagId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the tag"
              }
            ]
          },
          "docs": "Deletes a custom tag from the Enterprise Hub."
        }
      ]
    }
  ],
  "bundled": true
}